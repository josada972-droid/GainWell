# GainWell environment template. Copy to .env.local and fill in real values.
# Never commit .env files; commit only this template.

# Supabase (needed from Stage 2). Public values only — safe for the browser.
# Current key naming (replaces legacy anon/service-role keys).
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<sb_publishable_... key>

# Server-only secret. NEVER prefix with NEXT_PUBLIC and NEVER expose to the browser.
# Required from Stage 4: meal-entry writes and the Open Food Facts caches go
# through the privileged client (docs/supabase.md §9.3). Without it, tracker
# entry writes fail with a config message.
SUPABASE_SECRET_KEY=<sb_secret_... key, server code only>

# Default locale for next-intl (needed from Stage 1): en | fr
NEXT_PUBLIC_DEFAULT_LOCALE=en

# Optional contact address sent in the Open Food Facts User-Agent from Stage 4
# (polite per their API guidelines; e.g. you@example.com or a URL).
OPENFOODFACTS_CONTACT=
